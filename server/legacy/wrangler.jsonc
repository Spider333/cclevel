{
	"$schema": "../node_modules/wrangler/config-schema.json",
	// The board's first address. Deploy the board first, then: npx wrangler deploy -c legacy/wrangler.jsonc
	"name": "cclevel-board",
	"main": "index.js",
	"compatibility_date": "2026-03-01",
	// Served from workers.dev on purpose, like the board: a custom domain adds sampled request logs with IP addresses.
	"workers_dev": true,
	// Privacy: this Worker keeps no request logs. Do not switch this on.
	"observability": {
		"enabled": false
	},
	// No schedule: an empty list clears the one this Worker had when it was the board itself.
	"triggers": {
		"crons": []
	},
	// The board itself: no database and no secrets here. Secrets survive a deploy, so remove any old one by hand:
	// npx wrangler secret delete GITHUB_TOKEN --name cclevel-board (and put it on the board: npx wrangler secret put GITHUB_TOKEN)
	"services": [
		{
			"binding": "BOARD",
			"service": "go"
		}
	]
}
